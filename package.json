{
	"name": "sorebody",
	"type": "module",
	"changelog": {
		"icons": [
			"PadelRacket"
		]
	},
	"version": "1.29.1",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"astro": "astro",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"knip": "knip",
		"api": "node --watch --env-file-if-exists=.env src/backend/server.ts",
		"mcp:stdio": "node src/backend/stdio.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/node": "2.1.1",
		"@modelcontextprotocol/server": "2.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#v4.0.0",
		"@astrojs/check": "0.9.12",
		"@astrojs/markdown-satteri": "0.4.5",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/svelte": "9.1.1",
		"@csstools/postcss-global-data": "4.0.0",
		"@modelcontextprotocol/client": "2.3.1",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.5",
		"@types/three": "0.186.0",
		"astro": "7.4.2",
		"knip": "6.42.1",
		"lucide-static": "1.48.0",
		"oxlint": "1.87.0",
		"playwright": "1.64.1",
		"postcss-custom-media": "12.0.3",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"satteri": "0.10.5",
		"stylelint": "17.16.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"three": "0.186.1",
		"typescript": "6.0.3",
		"ultrahtml": "1.7.0",
		"yaml": "2.9.1"
	},
	"imports": {
		"#backend/*": "./src/backend/*",
		"#frontend/*": "./src/frontend/*",
		"#shared/*": "./src/shared/*"
	}
}
