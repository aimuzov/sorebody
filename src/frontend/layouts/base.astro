---
import { createHash } from 'node:crypto'

import { History, Info } from 'lucide-static'

import CornerLink from '#frontend/components/corner-link.astro'
import Footer from '#frontend/components/footer.astro'
import ThemeToggle from '#frontend/components/theme-toggle.astro'
import '#frontend/styles/global.css'
import ThemeBoot from '@aimuzov/infra-site-kit/theme-boot.astro'
import '@aimuzov/infra-site-kit/theme-peek.css'
import '@aimuzov/infra-site-kit/base.css'
import Metrika from '#frontend/components/metrika.astro'
import MetrikaPixel from '@aimuzov/infra-site-kit/metrika-pixel.astro'
import Sentry from '@aimuzov/infra-site-kit/sentry.astro'
import { site } from '#frontend/data/site.ts'
import type { SportSlug } from '#frontend/data/sports.ts'
import { BRAND_GRADIENT_CSS, BRAND_STOP_COUNT } from '#frontend/lib/brand-gradient.ts'
import { SPORT_RETURN } from '#frontend/lib/sport-memory.ts'
import { SPORT_TRANSITION } from '#frontend/lib/sport-switch.ts'
import { THEME_KEY } from '#frontend/lib/theme.ts'
import { pageTitle, siteTitle } from '#frontend/lib/title.ts'

type Props = {
	/** Название страницы, к нему добавится название сайта. У главной не задаётся. */
	title?: string
	/** `meta description` и `og:description`, по умолчанию `site.description`. */
	description?: string
	/** `false` у служебных страниц вроде 404: без canonical и с запретом индексации. */
	index?: boolean
	/** Страница на весь экран без подвала, как главная с 3D-моделью. */
	bare?: boolean
	/** Класс на `<body>`: полноэкранной странице нужно задать фон и токены всему документу. */
	bodyClass?: string
	/** Спорт страницы: `<html data-sport>` красит акцент его цветом (styles/global.css). */
	sport?: SportSlug
	/** Адрес canonical, если страница -- копия другой, по умолчанию своя. */
	canonical?: string
	/** Главные спортов у сцены: «Назад» на неё открывает выбранный спорт (lib/sport-memory.ts). */
	sportHomes?: Record<string, string>
}

const { title, description = site.description, index = true, bare = false, bodyClass, sport, sportHomes } = Astro.props

/**
 * Mini App Telegram помечаем на `<html>` до отрисовки, чтобы свои кнопки «Назад» не мигали.
 * Признаки те же, что в lib/telegram.ts: хеш от Telegram или флаг в sessionStorage.
 * Inline-скрипты Astro в CSP не хеширует, поэтому хеш считаем сами.
 */
const TELEGRAM_FLAG =
	"try{if(/tgWebApp(Data|Platform)=/.test(location.hash)||sessionStorage.getItem('sorebody:tg'))" +
	"document.documentElement.dataset.telegram=''}catch{if(/tgWebApp(Data|Platform)=/.test(location.hash))" +
	"document.documentElement.dataset.telegram=''}"

/**
 * Ключи хранилищ до переименования звались `wodcare:*`. Переносим их на `sorebody:*` раньше
 * ThemeBoot и флага Telegram, чтобы не сбросились тема и подсказка. Убрать через пару месяцев.
 */
const STORAGE_RENAME =
	"try{for(const s of[localStorage,sessionStorage])for(const k of Object.keys(s))if(k.startsWith('wodcare:')){" +
	"const n='sorebody:'+k.slice(8);if(s.getItem(n)===null)s.setItem(n,s.getItem(k));s.removeItem(k)}}catch{}"

Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(STORAGE_RENAME).digest('base64')}`)
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(TELEGRAM_FLAG).digest('base64')}`)
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(SPORT_RETURN).digest('base64')}`)
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(SPORT_TRANSITION).digest('base64')}`)
// Градиент бренда собирает из data/sports.ts lib/brand-gradient.ts, в <head> он встаёт строкой
Astro.csp?.insertStyleHash(`sha256-${createHash('sha256').update(BRAND_GRADIENT_CSS).digest('base64')}`)

/**
 * Метрика только в продовой сборке и только на продовом домене (components/metrika.astro).
 * `METRIKA=off` -- без счётчика вовсе (e2e, playwright.config.ts), `METRIKA=any-host` --
 * со счётчиком на любом хосте, чтобы проверить CSP на локальной сборке.
 */
const metrika = import.meta.env.PROD && process.env.METRIKA !== 'off'
const metrikaHost = process.env.METRIKA === 'any-host' ? '' : new URL(Astro.site!).hostname

/**
 * Чат со справочником (components/chat-entry.svelte): `CHAT=on` -- всем, `CHAT=preview` -- только
 * открывшим сайт с `?chat=1`. Без переменной кнопки чата нет: бэкенд чата включается отдельно.
 */
const chat = ['on', 'preview'].includes(process.env.CHAT ?? '') ? process.env.CHAT : undefined

const fullTitle = pageTitle(title)
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="ru" data-sport={sport} data-sport-homes={sportHomes && JSON.stringify(sportHomes)} data-chat={chat}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<!-- Картинка превью одна на сайт, её собирает scripts/brand/render.mjs -->
		<meta property="og:image" content={new URL('/brand/og.png', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<style is:inline set:html={BRAND_GRADIENT_CSS}></style>
		<script is:inline set:html={STORAGE_RENAME} />
		<script is:inline set:html={TELEGRAM_FLAG} />
		{sport && <script is:inline set:html={SPORT_RETURN} />}
		<script is:inline set:html={SPORT_TRANSITION} />
		<ThemeBoot key={THEME_KEY} />
		{metrika && <Metrika id={site.metrikaId} host={metrikaHost} />}
		<Sentry />
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		{metrika && <MetrikaPixel id={site.metrikaId} />}
		{!sport && (
			<svg class="brand-paint" aria-hidden="true" focusable="false">
				<defs>
					{/* Градиент для обводки значков Lucide (24 на 24) -- по диагонали. Знак логотипа
					    (32 на 32) -- начало перелива слова "body" (components/logo.svelte): синий
					    держится до "b" и знак целиком синий. 88 и 144 -- края слова в единицах знака */}
					{(
						[
							['brand-icon', 0, 24, 24],
							['brand-logo', 88, 144, 0],
						] as const
					).map(([id, x1, x2, y2]) => (
						<linearGradient id={id} gradientUnits="userSpaceOnUse" x1={x1} y1="0" x2={x2} y2={y2}>
							{Array.from({ length: BRAND_STOP_COUNT }, (_, i) => (
								<stop offset={i / Math.max(BRAND_STOP_COUNT - 1, 1)} class={`brand-stop-${i}`} />
							))}
						</linearGradient>
					))}
				</defs>
			</svg>
		)}
		<CornerLink href="/about/" label="О справочнике" icon={Info} place={2} />
		<CornerLink href="/changelog" label="Что нового" icon={History} place={1} />
		<ThemeToggle />
		<slot />
		{!bare && <Footer />}
		<script>
			import '#frontend/lib/telegram.ts'
			import { initHints } from '#frontend/lib/hint.ts'
			import { initSwipeBack } from '#frontend/lib/swipe-back.ts'
			import { initThemeToggle } from '#frontend/lib/theme.ts'

			initHints()
			initSwipeBack()
			initThemeToggle()
		</script>
	</body>
</html>
